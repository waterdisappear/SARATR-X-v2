# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
*.so
.eggs/
build/
dist/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# 训练产物 (training artifacts)
work_dirs/
checkpoints/
ckpts/
*.log
*.pth
*.pt
*.onnx

# 实验结果目录：保留检测/分割日志与配置（人工整理，随仓库提交）
!results/
!results/**
!results/detection/
!results/detection/**/*.log
!results/detection/**/*.log.json
!results/detection/**/*.py
!results/segmentation/
!results/segmentation/**/*.log
!results/segmentation/**/*.log.json
!results/segmentation/**/*.py
!results/visualize/
!results/visualize/**
# 但排除 results 下产生的 __pycache__ 等编译产物
results/**/__pycache__/
results/**/*.pyc

# 数据 (data stays local)
data/

# 可视化生成的图片 (generated figures)
*.png
*.pdf
*.svg
*.tif
*.tiff

# 论文图表（docs/figures）随仓库提交
!docs/figures/
!docs/figures/*.png
!docs/figures/*.pdf

# 权重/结果目录说明 README 保留；占位 .gitkeep 无规则匹配，默认保留
